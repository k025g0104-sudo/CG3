[*.{cpp.h}]
charset = utf-8

#スペルミスをintellsence上でのエラーとして扱う。
spelling_error_severity = error

#チェック対象を識別子（変数名など）と　コメントに限定する。
spelling_checkble_types = identifiers, comments

#辞書を英語に固定する
spelling_dictionary = en-us

#自分の辞書を作れるように標準の除外辞書設定はそのまま使用
spelling_use_default_exclusion_dictionary = true

#じぶんの除外辞書を指定
spelling_exclusion_path = ./exclusion_dic